# Convex. `npx convex dev` writes these two values to .env.local for you.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Optional. Shown on the privacy and terms pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# Kinde. Copy these from your Kinde application (Settings > Applications > Details).
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=https://<your-subdomain>.kinde.com
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/dashboard

# Set these three on the Convex deployment, not in .env.local:
#   npx convex env set KINDE_ISSUER_URL https://<your-subdomain>.kinde.com
#   npx convex env set KINDE_CLIENT_ID <client id>
#   npx convex env set SECRETS_MASTER_KEY "$(openssl rand -base64 32)"
# Optional. "hosted" turns on plans, billing, and the hosted limits. The default is "selfhosted".
#   npx convex env set DEPLOYMENT_MODE selfhosted
# Hosted only. The Gemini key that pays for Pro and Team. See "Paid plans" in the README.
#   npx convex env set HOSTED_GOOGLE_API_KEY <gemini key>
# Optional. A Kinde machine-to-machine app lets "Delete my account" remove the
# person's sign-in from Kinde, and lets billing read plans and report Team members.
#   npx convex env set KINDE_M2M_CLIENT_ID <client id>
#   npx convex env set KINDE_M2M_CLIENT_SECRET <client secret>

# Ad pixels for the hosted site. Each loads only after a visitor says yes to marketing cookies. Leave empty to turn one off.
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_X_PIXEL_ID=
